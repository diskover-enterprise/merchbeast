generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String
  logo              String?
  bannerImage       String?
  primaryColor      String    @default("#000000")
  secondaryColor    String    @default("#ffffff")
  accentColor       String    @default("#ff6600")
  fontFamily        String    @default("Inter")
  ownerEmail        String    @unique
  ownerPasswordHash String
  tagline           String?
  about             String?
  heroHeadline      String?
  instagram         String?
  websiteUrl        String?
  address           String?
  createdAt         DateTime  @default(now())
  products          Product[]
  orders            Order[]
  commissions       CommissionPayment[]
  discountCodes     DiscountCode[]
  shopSales         ShopSale[]

  @@map("Restaurant")
}

model Product {
  id           String      @id @default(cuid())
  shopId       String      @map("restaurantId")
  name         String
  description  String
  price        Int
  images       String      @default("[]")
  category     String
  stock        Int         @default(0)
  createdAt    DateTime    @default(now())
  shop         Shop        @relation(fields: [shopId], references: [id])
  orderItems   OrderItem[]
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  shopId          String      @map("restaurantId")
  status          String      @default("pending")
  total           Int
  stripePaymentId String?
  shippingAddress String?
  createdAt       DateTime    @default(now())
  customer        Customer    @relation(fields: [customerId], references: [id])
  shop            Shop        @relation(fields: [shopId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  productName     String?
  quantity        Int
  priceAtPurchase Int
  size            String?
  color           String?
  order           Order    @relation(fields: [orderId], references: [id])
  product         Product? @relation(fields: [productId], references: [id])
}

model ShopSale {
  id           String   @id @default(cuid())
  shopId       String   @map("restaurantId")
  name         String
  type         String   // "percentage" | "fixed"
  value        Int      // percentage 0-100, or fixed amount in cents
  scope        String   // "cart" | "products"
  productSlugs String   @default("[]") // JSON array of slugs, empty = all
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  shop         Shop     @relation(fields: [shopId], references: [id])

  @@map("ShopSale")
}

model DiscountCode {
  id             String    @id @default(cuid())
  shopId         String    @map("restaurantId")
  code           String
  type           String    // "percentage" | "fixed"
  value          Int       // percentage 0-100, or fixed amount in cents
  minOrderAmount Int       @default(0) // in cents
  maxUses        Int?      // null = unlimited
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  shop           Shop      @relation(fields: [shopId], references: [id])

  @@unique([shopId, code])
  @@map("DiscountCode")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model CommissionPayment {
  id           String   @id @default(cuid())
  shopId       String   @map("restaurantId")
  month        String   // e.g. "2026-06"
  revenue      Int      // in cents
  rate         Float    @default(0.25)
  paidAt       DateTime?
  note         String?
  createdAt    DateTime @default(now())
  shop         Shop     @relation(fields: [shopId], references: [id])
}

model PageView {
  id          String   @id @default(cuid())
  shopId      String
  productSlug String?
  createdAt   DateTime @default(now())

  @@index([shopId])
  @@index([shopId, productSlug])
  @@index([createdAt])
}

model MerchProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  shopId      String?
  name        String
  description String
  price       String
  images      String   @default("[]")
  sizes       String   @default("[]")
  colors      String   @default("[]")
  tag         String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
